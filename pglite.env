# The PGlite build that pytest-pglite packages: a commit of postgres-pglite
# with the standalone (non-JS) build, and the PGlite release it belongs to
# (for its version string).
# CI builds the artifacts from it; see scripts/fetch-artifacts.sh.
# The repository defaults to <owner of this repository>/postgres-pglite.
POSTGRES_PGLITE_REPOSITORY=
POSTGRES_PGLITE_REF=546a9e7941245ada6c9d38e9e0420462878f589b
PGLITE_VERSION=0.5.8
